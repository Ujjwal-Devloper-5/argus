# =============================================================================
# ARGUS — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# CAMERAS (add multiple with CAMERA_1_, CAMERA_2_ prefix)
# -----------------------------------------------------------------------------
CAMERA_1_NAME=front_door
CAMERA_1_RTSP_URL=rtsp://admin:password@192.168.0.100:554/stream1
CAMERA_1_RTSP_SUB_URL=rtsp://admin:password@192.168.0.100:554/stream2

# CAMERA_2_NAME=backyard
# CAMERA_2_RTSP_URL=rtsp://admin:password@192.168.0.101:554/stream1

# -----------------------------------------------------------------------------
# LLM PROVIDER (choose one)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama           # ollama | openai | anthropic | gemini | disabled

# Ollama (local, recommended)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# ALERTS
# -----------------------------------------------------------------------------

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email (SMTP)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=argus@yourdomain.com
EMAIL_TO=you@yourdomain.com
EMAIL_PASSWORD=your_app_password

# Webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-endpoint.com/argus/event

# ntfy (push notifications)
NTFY_ENABLED=false
NTFY_TOPIC=argus-alerts
NTFY_SERVER=https://ntfy.sh

# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local         # local | gdrive | s3 | sftp

# Local
LOCAL_STORAGE_PATH=./data/clips

# Google Drive (via rclone — run `rclone config` first)
# RCLONE_REMOTE=gdrive
# RCLONE_PATH=Security/Argus

# S3-Compatible (AWS / Cloudflare R2 / Backblaze B2)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=argus-security
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# DASHBOARD
# -----------------------------------------------------------------------------
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_please

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/argus.db

# -----------------------------------------------------------------------------
# PERFORMANCE
# -----------------------------------------------------------------------------
DEVICE=cuda                   # cuda | cpu | mps (Apple Silicon)
DETECTION_MODEL=yolov8n       # yolov8n | yolov8s | yolov8m | yolov8l | yolov8x
STREAM_FPS=10                 # Process N frames per second (lower = less CPU)

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./data/argus.log
